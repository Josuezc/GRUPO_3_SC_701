@model GRUPO_3_SC_701.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard de Administración";
}

<h2>Dashboard de Administración</h2>

<div class="row">
    <!-- Rutas Activas -->
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Rutas Activas</h5>
                <p class="card-text display-4">@Model.TotalActiveRoutes</p>
            </div>
        </div>
    </div>

    <!-- Vehículos en Buen Estado -->
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Vehículos Buenos</h5>
                <p class="card-text display-4">@Model.TotalGoodVehicles</p>
            </div>
        </div>
    </div>

    <!-- Vehículos Regulares -->
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Vehículos Regulares</h5>
                <p class="card-text display-4">@Model.TotalRegularVehicles</p>
            </div>
        </div>
    </div>

    <!-- Vehículos con Mantenimiento -->
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title">Vehículos en Mantenimiento</h5>
                <p class="card-text display-4">@Model.TotalMaintenanceVehicles</p>
            </div>
        </div>
    </div>
</div>

<!-- Otra fila para boletos vendidos -->
<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Boletos Vendidos (Mes Actual)</h5>
                <p class="card-text display-4">@Model.TotalTicketsCurrentMonth</p>
            </div>
        </div>
    </div>
</div>

<hr />
<!-- Tabla de boletos por usuario -->
<h3>Boletos por Usuario</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Ruta</th>
            <th>Horario</th>
            <th>Fecha de Compra</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model.UserTickets)
        {
            <tr>
                <td>@ticket.Usuario</td>
                <td>@ticket.Ruta</td>
                <td>@ticket.Horario</td>
                <td>@ticket.FechaCompra</td>
            </tr>
        }
    </tbody>
</table>
