@model GRUPO_3_SC_701.Models.Vehiculo

@{
    ViewData["Title"] = "Detalles del Vehículo";
}

<div class="container mt-4">
    <h2 class="mb-3">🚗 Detalles del Vehículo</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">📋 Información General</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-4 text-muted">🔢 Placa</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Placa)</dd>

                <dt class="col-sm-4 text-muted">🚙 Modelo</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Modelo)</dd>

                <dt class="col-sm-4 text-muted">👥 Capacidad</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Capacidad) pasajeros</dd>

                <dt class="col-sm-4 text-muted">⚙️ Estado</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Estado)</dd>

                <dt class="col-sm-4 text-muted">📅 Fecha de Registro</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaRegistro)</dd>

                <dt class="col-sm-4 text-muted">👤 Usuario de Registro</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.UsuarioRegistro.UserName)</dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">📋 Volver a la lista</a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">✏️ Editar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
