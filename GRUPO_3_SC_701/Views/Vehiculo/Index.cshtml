@model IEnumerable<GRUPO_3_SC_701.Models.Vehiculo>

@{
    ViewData["Title"] = "Vehículos";
}

<div class="container mt-4">
    <h2 class="mb-3">🚗 Lista de Vehículos</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="lead">Aquí puedes gestionar los vehículos disponibles en el sistema.</p>
        <a asp-action="Create" class="btn btn-primary">➕ Agregar Vehículo</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Placa)</th>
                <th>@Html.DisplayNameFor(model => model.Modelo)</th>
                <th>@Html.DisplayNameFor(model => model.Estado)</th>
                <th>👤 Conductor</th>
                <th class="text-center">⚙️ Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Placa)</td>
                    <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                    <td>@(item.UsuarioRegistro?.Email ?? "Sin asignar")</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">✏️ Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">🔍 Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">🗑 Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
