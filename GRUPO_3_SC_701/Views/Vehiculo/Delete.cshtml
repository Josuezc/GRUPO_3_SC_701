@model GRUPO_3_SC_701.Models.Vehiculo

@{
    ViewData["Title"] = "Eliminar Vehículo";
}

<div class="container mt-4">
    <h2 class="mb-3 text-danger">🗑 Eliminar Vehículo</h2>
    <p class="text-warning"><strong>⚠️ Atención:</strong> Esta acción no se puede deshacer. ¿Está seguro que desea eliminar este vehículo?</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">🚗 Detalles del Vehículo</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-4">🔢 Placa</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Placa)</dd>

                <dt class="col-sm-4">🚙 Modelo</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Modelo)</dd>

                <dt class="col-sm-4">👥 Capacidad</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Capacidad) pasajeros</dd>

                <dt class="col-sm-4">⚙️ Estado</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Estado)</dd>

                <dt class="col-sm-4">📅 Fecha de Registro</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaRegistro)</dd>

                <dt class="col-sm-4">👤 Usuario de Registro</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.UsuarioRegistro.Id)</dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">🔙 Cancelar</a>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">🗑 Eliminar Vehículo</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
