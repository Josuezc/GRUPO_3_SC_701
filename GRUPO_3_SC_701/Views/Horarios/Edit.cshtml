@model GRUPO_3_SC_701.Models.Horario

@{
    ViewData["Title"] = "Editar Horario";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-warning text-white text-center">
                    <h3><i class="fas fa-edit"></i> Editar Horario</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group">
                            <label asp-for="RutaId"><i class="fas fa-route"></i> Ruta</label>
                            <select asp-for="RutaId" class="form-control selectpicker" asp-items="ViewBag.RutaId" data-live-search="true">
                                <option value="">Seleccione una Ruta</option>
                            </select>
                            <span asp-validation-for="RutaId" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-3">
                            <label asp-for="Hora"><i class="fas fa-clock"></i> Hora</label>
                            <input asp-for="Hora" class="form-control" type="time" />
                            <span asp-validation-for="Hora" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-3">
                            <label asp-for="VehiculoId"><i class="fas fa-bus"></i> Vehículo</label>
                            <select asp-for="VehiculoId" class="form-control selectpicker" asp-items="ViewBag.VehiculoId" data-live-search="true">
                                <option value="">Seleccione un Vehículo</option>
                            </select>
                            <span asp-validation-for="VehiculoId" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Guardar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
