@model GRUPO_3_SC_701.Models.Horario

@{
    ViewData["Title"] = "Detalles del Horario";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info text-white text-center">
                    <h3><i class="fas fa-info-circle"></i> Detalles del Horario</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <!-- Ruta -->
                        <dt class="col-sm-4 text-end">
                            <i class="fas fa-route"></i> Ruta:
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Ruta.Codigo)
                        </dd>

                        <!-- Hora -->
                        <dt class="col-sm-4 text-end">
                            <i class="fas fa-clock"></i> Hora:
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Hora)
                        </dd>

                        <!-- Vehículo -->
                        <dt class="col-sm-4 text-end">
                            <i class="fas fa-bus"></i> Vehículo:
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Vehiculo.Modelo)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver a la Lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
