@model GRUPO_3_SC_701.Models.Horario

@{
    ViewData["Title"] = "Eliminar Horario";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center">
                    <h3><i class="fas fa-trash-alt"></i> Eliminar Horario</h3>
                </div>
                <div class="card-body">
                    <p class="text-center text-danger fw-bold">
                        ¿Está seguro de que desea eliminar este horario? Esta acción no se puede deshacer.
                    </p>
                    <dl class="row">
                        <dt class="col-sm-4 text-end">
                            <i class="fas fa-route"></i> Ruta:
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Ruta.Codigo)
                        </dd>

                        <dt class="col-sm-4 text-end">
                            <i class="fas fa-clock"></i> Hora:
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Hora)
                        </dd>

                        <dt class="col-sm-4 text-end">
                            <i class="fas fa-bus"></i> Vehículo:
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Vehiculo.Modelo)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer text-center">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Confirmar Eliminación
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Cancelar
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
