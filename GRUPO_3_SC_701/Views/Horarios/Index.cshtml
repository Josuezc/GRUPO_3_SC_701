@model IEnumerable<GRUPO_3_SC_701.Models.Horario>

@{
    ViewData["Title"] = "Horarios";
}

<div class="container mt-4">
    <h2 class="mb-3">📅 Horarios de Rutas</h2>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            + Crear Nuevo Horario
        </a>
    </div>

    <table class="table table-striped">
        <thead class="table-light">
            <tr>
                <th>Ruta</th>
                <th>Hora</th>
                <th>Vehículo</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Ruta.Codigo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Hora)</td>
                    <td>@Html.DisplayFor(modelItem => item.Vehiculo.Modelo)</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
