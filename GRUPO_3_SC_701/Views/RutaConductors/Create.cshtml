@model GRUPO_3_SC_701.Models.RutaConductor

@{
    ViewData["Title"] = "Asignar Vehículo a Ruta";
}

<div class="container mt-4">
    <h2 class="mb-3 text-primary">🛤 Asignar Vehículo a Ruta</h2>

    <div class="card shadow p-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="RutaId" class="form-label">🛤 Seleccione una Ruta</label>
                <select asp-for="RutaId" class="form-select" asp-items="ViewBag.RutaId">
                    <option value="">Seleccione una Ruta</option>
                </select>
                <span asp-validation-for="RutaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VehiculoId" class="form-label">🚗 Seleccione un Vehículo</label>
                <select asp-for="VehiculoId" class="form-select" asp-items="ViewBag.VehiculoId">
                    <option value="">Seleccione un Vehículo</option>
                </select>
                <span asp-validation-for="VehiculoId" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">🔙 Volver al Listado</a>
                <button type="submit" class="btn btn-success">✅ Asignar Vehículo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
