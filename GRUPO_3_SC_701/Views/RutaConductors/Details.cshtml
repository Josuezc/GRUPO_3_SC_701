@model GRUPO_3_SC_701.Models.RutaConductor

@{
    ViewData["Title"] = "Detalles de Asignación";
}

<div class="container mt-4">
    <h2 class="mb-3 text-primary">📌 Detalles de la Asignación</h2>

    <div class="card shadow p-4">
        <h4 class="text-success">🛤 Información de la Ruta y Vehículo</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">🚏 Ruta Asignada:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Ruta.Codigo)</dd>

            <dt class="col-sm-4">🚗 Vehículo Asignado:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Vehiculo.Modelo)</dd>
        </dl>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">🔙 Volver al Listado</a>
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">✏️ Editar</a>
        </div>
    </div>
</div>
