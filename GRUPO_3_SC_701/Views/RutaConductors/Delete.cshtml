@model GRUPO_3_SC_701.Models.RutaConductor

@{
    ViewData["Title"] = "Eliminar Asignación";
}

<div class="container mt-4">
    <h2 class="mb-3 text-danger">⚠️ Eliminar Asignación de Vehículo</h2>

    <div class="alert alert-warning">
        <strong>⚠️ Advertencia:</strong> Si elimina esta asignación, el vehículo quedará sin una ruta asignada.
        Esta acción no se puede deshacer.
    </div>

    <div class="card shadow p-4">
        <h4 class="text-primary">🛤 Información de la Asignación</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Ruta:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Ruta.Codigo)</dd>

            <dt class="col-sm-4">Vehículo:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Vehiculo.Modelo)</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">🔙 Cancelar</a>
                <button type="submit" class="btn btn-danger">❌ Eliminar Asignación</button>
            </div>
        </form>
    </div>
</div>
