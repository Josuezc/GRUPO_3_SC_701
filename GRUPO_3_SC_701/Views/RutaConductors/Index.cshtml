@model IEnumerable<GRUPO_3_SC_701.Models.RutaConductor>

@{
    ViewData["Title"] = "Ruta / Vehículo";
}

<div class="container mt-4">
    <h2 class="mb-3 text-primary">🛤 Asignación de Rutas a Vehículos</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Create" class="btn btn-success">
            ➕ Asignar Ruta a Vehículo
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>🚏 Ruta</th>
                    <th>🚗 Vehículo</th>
                    <th>👤 Conductor</th>
                    <th>⚙️ Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Ruta.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.Vehiculo.Modelo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Vehiculo.UsuarioRegistro.UserName)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                ✏️ Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                📄 Detalles
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                ❌ Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
