@model IEnumerable<GRUPO_3_SC_701.Models.RutaConductor>

@{
    ViewData["Title"] = "Ruta / Vehículo";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-info  btn-sm">Asignar ruta a vehículo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ruta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Vehiculo)
            </th>
            <th>
                <a>Conductor</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                @Html.DisplayFor(modelItem => item.Ruta.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Vehiculo.Modelo)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Vehiculo.UsuarioRegistro.UserName)
                </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning  btn-sm">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info  btn-sm">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
