@model GRUPO_3_SC_701.Models.Boleto
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Eliminar Boleto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center">
                    <h3><i class="fas fa-trash-alt"></i> Eliminar Boleto</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning text-center">
                        <strong>¿Estás seguro que deseas eliminar este boleto?</strong><br>
                        Esta acción no se puede deshacer.
                    </div>

                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th><i class="fas fa-user"></i> Usuario</th>
                                <td>@(Model.Usuario != null ? Model.Usuario.UserName : "No asignado")</td>
                            </tr>
                            <tr>
                                <th><i class="far fa-clock"></i> Horario</th>
                                <td>@(Model.Horario != null ? Model.Horario.Id.ToString() : "No asignado")</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-calendar-alt"></i> Fecha de Compra</th>
                                <td>@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Confirmar Eliminación
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
