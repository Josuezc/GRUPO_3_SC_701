@model GRUPO_3_SC_701.Models.Boleto
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Detalles del Boleto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center">
                    <h3><i class="fas fa-ticket-alt"></i> Detalles del Boleto</h3>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th><i class="fas fa-user"></i> Usuario</th>
                                <td>@(Model.Usuario != null ? Model.Usuario.UserName : "No asignado")</td>
                            </tr>
                            <tr>
                                <th><i class="far fa-clock"></i> Horario</th>
                                <td>@(Model.Horario != null ? Model.Horario.Id.ToString() : "No asignado")</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-calendar-alt"></i> Fecha de Compra</th>
                                <td>@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Editar
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Volver a la lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
