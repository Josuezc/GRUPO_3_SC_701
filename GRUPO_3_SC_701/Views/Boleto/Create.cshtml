@model GRUPO_3_SC_701.Models.Boleto
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Crear Boleto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center">
                    <h3><i class="fas fa-ticket-alt"></i> Crear Boleto</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            var roles = await UserManager.GetRolesAsync(user);
                            var userRol = roles.Any() ? roles.First() : "Sin Rol";

                            @if (userRol == "Administrador")
                            {
                                <div class="form-group">
                                    <label asp-for="UsuarioId" class="form-label"><i class="fas fa-user"></i> Usuario</label>
                                    <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.UsuarioId"></select>
                                </div>
                            }

                            @if (userRol == "Usuario")
                            {
                                <div class="form-group">
                                    <label asp-for="UsuarioId" class="form-label"><i class="fas fa-user"></i> Usuario</label>
                                    <input type="text" id="UsuarioNombre" class="form-control" value="@User.Identity.Name" readonly />
                                    <input type="hidden" asp-for="UsuarioId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
                                </div>
                            }
                        }

                        <div class="form-group mt-3">
                            <label asp-for="HorarioId" class="form-label"><i class="far fa-clock"></i> Horario</label>
                            <select asp-for="HorarioId" class="form-select" asp-items="ViewBag.HorarioId"></select>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-plus-circle"></i> Crear Boleto
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Volver a la lista
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
