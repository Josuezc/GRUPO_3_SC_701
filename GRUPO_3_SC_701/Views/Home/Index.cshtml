@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    ViewData["Title"] = "Home Page";
}
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
    var userRol = roles.FirstOrDefault() ?? "Sin Rol";

    <hr />
    <h2 class="text-center text-uppercase mt-4 mb-4">Panel de Control</h2>
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @if (userRol == "Administrador")
        {
            @Html.Raw(GetAdminCards())
        }
        else if (userRol == "Conductor")
        {
            @Html.Raw(GetConductorCards())
        }
        else if (userRol == "Usuario")
        {
            @Html.Raw(GetUsuarioCards())
        }
    </div>
}

